# Server Configuration
PORT=3000
NODE_ENV=production

# Database Credentials (Standard & Railway format supported)
# Option A: Individual Variables
DB_HOST=localhost
DB_PORT=3306
DB_NAME=explore_lanka_db
DB_USER=root
DB_PASSWORD=

# Railway MySQL Plugin Variables (Auto-injected on Railway)
MYSQLHOST=${DB_HOST}
MYSQLPORT=${DB_PORT}
MYSQLDATABASE=${DB_NAME}
MYSQLUSER=${DB_USER}
MYSQLPASSWORD=${DB_PASSWORD}

# Option B: Connection URL (e.g. mysql://user:password@host:port/database)
# MYSQL_URL=
# DATABASE_URL=

# Session Security & Proxy Settings
SESSION_SECRET=replace-with-a-long-secure-random-string
COOKIE_SECURE=true

# Persistent Media Uploads Directory (Mount path for Railway Persistent Volume)
# e.g., /app/uploads or /data/uploads on Railway
UPLOAD_DIR=public/uploads
